  "read_plan": {
    "serial_by_default_per_repository_lane": true,
    "minimum_sufficient_retrieval_required": true,
    "changed_files_on_demand_only": true,
    "tight_polling_allowed": false,
    "prefer_event_state_over_polling": true,
    "reuse_same_step_evidence_when_sufficient": true,
    "historical_workflow_runs_by_default": false,
    "dispositions": [
      "PRIMARY_RATE_LIMIT_EXHAUSTED",
      "SECONDARY_RATE_LIMIT_SUSPECTED",
