# SOURCE-ONLY BLUEPRINT.
# Do not install, enable, start, restart, or otherwise activate this unit
# without a separate explicit owner-authorized production gate.
#
# The agent owns the bounded host-read boundary. Its primary group lets the web
# identity consume the agent Unix API. Docker and host-log reads are delegated
# to dedicated broker-client groups; it must never inherit docker, video, adm,
# systemd-journal, sudo or root authority.

[Unit]
Description=dashboard_RPi5 local read agent
After=local-fs.target

[Service]
Type=exec
User=dashboard-rpi5-agent
Group=dashboard-rpi5-agent-client
SupplementaryGroups=dashboard-rpi5-docker-client dashboard-rpi5-log-client
WorkingDirectory=/opt/dashboard_RPi5/current
Environment=DASHBOARD_RPI5_AGENT_SOCKET=/run/dashboard-rpi5/agent.sock
Environment=DASHBOARD_DOCKER_BROKER_SOCKET=/run/dashboard-rpi5-docker-broker/broker.sock
Environment=DASHBOARD_LOG_BROKER_SOCKET=/run/dashboard-rpi5-log-broker/broker.sock
# Owner-gated capability: keep OFF in the canonical blueprint. Enabling this
# requires a separate explicit owner-authorized production configuration change.
Environment=DASHBOARD_RPI5_QUICK_COMMANDS=disabled
ExecStart=/usr/bin/node /opt/dashboard_RPi5/current/apps/agent/dist/index.js
Restart=on-failure
RestartSec=5s

RuntimeDirectory=dashboard-rpi5
RuntimeDirectoryMode=0750
UMask=0007

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target