# SOURCE-ONLY BLUEPRINT.
# Do not install, enable, start, restart, or otherwise activate this unit
# without separate owner authorization under issue #1.
#
# Canonical production identity: dashboard-rpi5-web.
# This base unit intentionally does NOT grant dashboard-rpi5-terminal-client.
# Terminal connector membership is a separate owner-gated production change.

[Unit]
Description=dashboard_RPi5 loopback web and API service
After=network-online.target dashboard-rpi5-agent.service
Wants=network-online.target

[Service]
Type=exec
User=dashboard-rpi5-web
Group=dashboard-rpi5-web
SupplementaryGroups=dashboard-rpi5-agent-client
WorkingDirectory=/opt/dashboard_RPi5/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/dashboard-rpi5/web.env
EnvironmentFile=-/etc/dashboard-rpi5/terminal.env
ExecStart=/usr/bin/node /opt/dashboard_RPi5/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=5s

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
