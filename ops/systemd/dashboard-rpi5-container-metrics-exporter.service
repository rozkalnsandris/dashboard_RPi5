# SOURCE-ONLY BLUEPRINT.
# Do not install, enable, start, restart, or otherwise activate this unit
# without a separate explicit owner-authorized production gate.
#
# The exporter has no Docker Engine authority. It may only consume the fixed
# bounded container-metrics capability through the existing broker client group.

[Unit]
Description=dashboard_RPi5 bounded container metrics exporter
After=local-fs.target dashboard-rpi5-docker-broker.service

[Service]
Type=exec
User=dashboard-rpi5-container-metrics-exporter
DynamicUser=yes
SupplementaryGroups=dashboard-rpi5-docker-client
WorkingDirectory=/opt/dashboard_RPi5/current
Environment=DASHBOARD_DOCKER_BROKER_SOCKET=/run/dashboard-rpi5-docker-broker/broker.sock
EnvironmentFile=/etc/dashboard-rpi5/container-metrics-exporter.env
ExecStart=/usr/bin/node /opt/dashboard_RPi5/current/apps/agent/dist/container-metrics-exporter-entry.js
Restart=on-failure
RestartSec=5s
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
