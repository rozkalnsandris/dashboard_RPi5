# SOURCE-ONLY BLUEPRINT.
# Do not install, enable, start, restart, create identities/groups, or otherwise
# activate this unit without a separate explicit owner-authorized production gate.
#
# This isolated broker is the only dashboard_RPi5 process intended to read the
# reviewed journal sources and the fixed root-owned backup log. It exposes only
# fixed bounded read capabilities over a local Unix socket; the main agent stays
# non-root and does not join adm/systemd-journal.

[Unit]
Description=dashboard_RPi5 bounded host log read broker
After=local-fs.target systemd-journald.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=root
Group=dashboard-rpi5-log-client
WorkingDirectory=/opt/dashboard_RPi5/current
Environment=DASHBOARD_LOG_BROKER_SOCKET=/run/dashboard-rpi5-log-broker/broker.sock
ExecStart=/usr/bin/node /opt/dashboard_RPi5/current/apps/agent/dist/log-broker-entry.js
Restart=on-failure
RestartSec=5s

RuntimeDirectory=dashboard-rpi5-log-broker
RuntimeDirectoryMode=0750
# AF_UNIX path mode is 0777 & ~UMask, so create it at the final 0660 client mode.
UMask=0117

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
InaccessiblePaths=-/etc/dashboard-rpi5 -/etc/cloudflared -/etc/ssl/private -/etc/NetworkManager/system-connections
TasksMax=48
MemoryMax=192M

[Install]
WantedBy=multi-user.target
