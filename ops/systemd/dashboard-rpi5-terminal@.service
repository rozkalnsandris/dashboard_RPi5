# SOURCE-ONLY BLUEPRINT.
# Do not install, enable, start, restart, or otherwise activate this unit
# without separate owner authorization under issue #1.

[Unit]
Description=dashboard_RPi5 contained terminal session %i
After=local-fs.target

[Service]
Type=exec
User=dashboard-rpi5-terminal
Group=dashboard-rpi5-terminal
SupplementaryGroups=
WorkingDirectory=/var/lib/dashboard-rpi5-terminal
ExecStart=/usr/bin/node /opt/dashboard_RPi5/apps/terminal-agent/dist/session-stdio-entry.js
StandardInput=socket
StandardOutput=socket
StandardError=journal
Restart=no

# The service instance is the containment boundary for one accepted socket.
# When the Node worker exits, systemd terminates every process left in this cgroup.
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=2s
RuntimeMaxSec=30min

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
TasksMax=64
MemoryMax=256M

# Prevent the shell from reaching privileged local control sockets even if those
# paths exist on the host. The '-' prefix keeps absent paths non-fatal.
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/dbus/system_bus_socket -/run/systemd/private
