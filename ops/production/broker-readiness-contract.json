{
  "schema": "dashboard-rpi5.broker-readiness.v1",
  "sourceOnly": true,
  "service": "dashboard-rpi5-docker-broker.service",
  "systemdType": "exec",
  "readinessModel": "application-probed",
  "systemdActiveIsSufficient": false,
  "socketActivationSelected": false,
  "notifySelected": false,
  "runtime": {
    "socket": "/run/dashboard-rpi5-docker-broker/broker.sock",
    "socketOwner": "dashboard-rpi5-docker-broker",
    "socketGroup": "dashboard-rpi5-docker-client",
    "socketMode": "0660",
    "runtimeDirectory": "/run/dashboard-rpi5-docker-broker",
    "runtimeDirectoryMode": "0750",
    "stableMainPidRequired": true,
    "stableNRestartsRequired": true,
    "exactReleaseCwdRequired": true
  },
  "applicationAcceptance": {
    "healthPath": "/v1/health",
    "dockerPath": "/v1/docker/containers",
    "approvedLogPaths": [
      "/v1/docker/logs/homeassistant/15m",
      "/v1/docker/logs/prometheus/24h"
    ],
    "eventsPath": "/v1/docker/events/recent",
    "eventsRequiredQuery": ["since", "until"],
    "eventsMaxWindowSeconds": 3600,
    "eventsMaxItems": 512,
    "requiredSuccessStatus": 200,
    "failClosedPaths": [
      "/v1/docker/logs/homeassistant/7d"
    ],
    "requiredFailClosedStatus": 404
  },
  "startupContract": {
    "listenEventRequiredBeforeSocketSecurity": true,
    "listenErrorFailsStartup": true,
    "boundedExternalReadinessProbeRequired": true
  },
  "mutationAllowed": false,
  "unitMutationAllowed": false,
  "identityMutationAllowed": false,
  "dockerAuthorityExpansionAllowed": false,
  "terminalMutationAllowed": false,
  "eventsMutationAllowed": false
}
