{
  "schema": "dashboard-rpi5.native-artifact-quarantine-design.v1",
  "repository": "rozkalnsandris/dashboard_RPi5",
  "status": "SOURCE_DESIGN_ONLY_NO_HOST_IMPORTER",
  "provenance": {
    "authenticatedGitHubRestRequired": true,
    "exactMainShaRequired": true,
    "exactPushRunAndArtifactRequired": true,
    "completeJobsAndArtifactsRequired": true,
    "independentOwnerPinnedCandidateDigestRequired": true,
    "fullArchiveByteClosureBeforeAnyHostWrite": true
  },
  "quarantine": {
    "approvedParent": "NOT_SELECTED",
    "approvedTarget": "NOT_SELECTED",
    "hostTargetBound": false,
    "rootOutsideProductionReleaseTreeRequired": true,
    "importerIdentity": "unprivileged-dedicated",
    "exclusiveNewDirectoryRequired": true,
    "descriptorRelativeNoFollowRequired": true,
    "noSymlinksHardlinksOrSpecialFiles": true,
    "archivePathOrModeControlsFilesystem": false,
    "allowOnlyVerifiedManifestMembers": true,
    "directoryMode": "0700",
    "fileMode": "0600",
    "executeCandidateCode": false,
    "useDockerSocketOrPrivilegedAgent": false
  },
  "staging": {
    "ownerAuthorizationBeforeFirstHostWrite": true,
    "oneBoundedImportOnly": true,
    "noOverwriteExistingTargets": true,
    "noMutableRefReResolution": true,
    "writeVerificationBeforeEvidenceReceipt": true,
    "receiptProvesDeployAuthority": false,
    "postWriteFailure": "PRESERVE_EVIDENCE_AND_STOP",
    "retry": false,
    "rollback": false,
    "automaticCleanup": false
  },
  "boundary": {
    "quarantineIsNotProduction": true,
    "rootOwnedCurrentControllerOnly": true,
    "trustedControllerMustIndependentlyReverifyCandidate": true,
    "separateOwnerGateForTrustedPlan": true,
    "separateOwnerGateForApply": true,
    "restartMustBeExplicitlyIncludedInLiveGate": true,
    "noSystemdCloudflareDockerOrPermissionMutation": true
  },
  "authority": {
    "importerExecutableImplemented": false,
    "importerTargetConfigured": false,
    "privilegedEntrypointCreated": false,
    "automaticArtifactDownload": false,
    "automaticImport": false,
    "automaticDeploy": false,
    "hostMutationAuthorized": false,
    "mergeAuthorizesLive": false
  }
}
