# SOURCE-ONLY EXAMPLE. Do not copy into /etc or activate without owner authorization.
# No secrets belong in this repository.

PORT=8787
DASHBOARD_WEB_ROOT=/opt/dashboard_RPi5/current/apps/web/dist
DASHBOARD_AGENT_SOCKET_PATH=/run/dashboard-rpi5/agent.sock

# Highest-risk capability remains disabled in the base production environment.
DASHBOARD_TERMINAL_ENABLED=disabled

# Optional existing read-only integrations. Configure only with reviewed,
# server-side targets; never put credentials in URLs.
# DASHBOARD_PROMETHEUS_URL=http://127.0.0.1:9090
# DASHBOARD_PROMETHEUS_NODE_INSTANCE=127.0.0.1:9100
# DASHBOARD_GRAFANA_URL=https://grafana.rozkalns.net
# DASHBOARD_GRAFANA_HOST_DASHBOARD_PATH=/d/<uid>/<slug>
