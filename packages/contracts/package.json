{
  "name": "@dashboard-rpi5/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/activity.ts",
    "./agent": "./src/agent.ts",
    "./backups": "./src/backups.ts",
    "./backup-status": "./src/backup-status.ts",
    "./deploy": "./src/deploy.ts",
    "./deployment-status": "./src/deployment-status.ts",
    "./endpoints": "./src/endpoints.ts",
    "./history": "./src/history.ts",
    "./logs": "./src/logs.ts",
    "./maintenance": "./src/maintenance.ts",
    "./services": "./src/services.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup src/index.ts src/activity.ts src/agent.ts src/backups.ts src/backup-status.ts src/deploy.ts src/deployment-status.ts src/endpoints.ts src/history.ts src/logs.ts src/maintenance.ts src/services.ts --format esm --platform neutral --clean"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  }
}
